# Generated by golang-service-docker.

# Repository metadata, local secrets, editor state, and scratch output.
**/.git/
**/.env
**/.idea/
**/.vscode/
**/.worktrees/
**/*.tmp
**/*.log
**/coverage.out
**/coverage.html
**/.DS_Store

# Source mode compiles inside Docker and never needs host build output.
**/bin/

# Monorepo context (servekit root): the Go build needs testkit-service plus the
# locally replaced checkouts (go.mod replace) — user/license/telemetry/storage/
# message/gid-service and the api contract repo (gen/go). Exclude the rest and
# everything frontend-related to keep the context small.
/download-proxy/
/specs/
/docs/
/dev-skills/
/.zcode/
**/node_modules/
**/dist/
**/web/
**/api/swagger/
