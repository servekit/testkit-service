# =============================================================================
# testkit-service environment configuration
# =============================================================================
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Every ${VAR} referenced in config.example.yaml is listed below. configx uses
# os.ExpandEnv, so an unset var expands to "".
#
# These defaults are docker-compose oriented — hostnames are compose service
# names (postgres, redis). For a LOCAL binary run (make run), swap them for
# local addresses, e.g.:
#   TESTKIT_SERVICE_DB_HOST: postgres   -> localhost
#   TESTKIT_SERVICE_REDIS_ADDR: redis:6379 -> localhost:6379
#
# docker-compose: load via `env_file: .env` (or the `environment:` block).
#
# NOTE: docker-compose `env_file` does NOT support inline `#` comments — keep
# all comments on their own line (as this file does).

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
TESTKIT_SERVICE_SERVER_GRPC_ADDR=:19095
TESTKIT_SERVICE_SERVER_GATEWAY_ADDR=:18085

# -----------------------------------------------------------------------------
# Database (PostgreSQL via dbx) — shared across all four embedded modules.
# dbx.Config is dialect-pluggable (driver below); testkit ships postgres-only.
# -----------------------------------------------------------------------------
# Dialect selector — empty defaults to postgres. mysql/sqlite are supported by
# dbx but unused here; switching also needs the matching nested block
# (mysql: / sqlite:) in config.yaml.
TESTKIT_SERVICE_DB_DRIVER=postgres
# PostgreSQL connection (read only when driver=postgres).
TESTKIT_SERVICE_DB_HOST=postgres
TESTKIT_SERVICE_DB_PORT=5432
TESTKIT_SERVICE_DB_USER=postgres
TESTKIT_SERVICE_DB_PASSWORD=change-me
TESTKIT_SERVICE_DB_NAME=testkit
TESTKIT_SERVICE_DB_SSLMODE=disable
# TESTKIT_SERVICE_DB_SCHEMA=                  # optional search_path; empty = server default (public)
# Shared connection-pool settings (every dialect).
TESTKIT_SERVICE_DB_MAX_OPEN_CONNS=25
TESTKIT_SERVICE_DB_MAX_IDLE_CONNS=10
TESTKIT_SERVICE_DB_CONN_MAX_LIFETIME=5m
# silent, error, warn, info
TESTKIT_SERVICE_DB_LOG_LEVEL=warn
TESTKIT_SERVICE_DB_SLOW_THRESHOLD=200ms
# skip implicit transaction for single ops (recommended for production)
TESTKIT_SERVICE_DB_SKIP_DEFAULT_TX=true
# disable foreign key constraints in migration
TESTKIT_SERVICE_DB_DISABLE_FK=true
# prefix for testkit-owned tables (testkit has none in P1)
TESTKIT_SERVICE_DB_TABLE_PREFIX=

# -----------------------------------------------------------------------------
# Redis — shared across all four embedded modules
# -----------------------------------------------------------------------------
TESTKIT_SERVICE_REDIS_ADDR=redis:6379
# Sentinel (HA) — set BOTH master_name and sentinel_addrs to use sentinel
# instead of addr. Empty = standalone mode (addr is used).
TESTKIT_SERVICE_REDIS_MASTER_NAME=
TESTKIT_SERVICE_REDIS_SENTINEL_ADDRS=
TESTKIT_SERVICE_REDIS_USERNAME=
TESTKIT_SERVICE_REDIS_PASSWORD=
TESTKIT_SERVICE_REDIS_DB=0
TESTKIT_SERVICE_REDIS_CLIENT_NAME=
# Pool sizing. 0 = go-redis default (pool_size 10*GOMAXPROCS, ~80 on 8 cores;
# min_idle_conns disabled). Raise pool_size on redis.ErrPoolExhausted.
TESTKIT_SERVICE_REDIS_POOL_SIZE=0
TESTKIT_SERVICE_REDIS_MIN_IDLE_CONNS=0
# Conn lifetime. conn_max_idle 0s = go-redis 30m default; conn_max_life 0s = unlimited.
TESTKIT_SERVICE_REDIS_CONN_MAX_IDLE=30m
TESTKIT_SERVICE_REDIS_CONN_MAX_LIFE=0s
# Timeouts (0s = go-redis defaults shown). Lower dial/read if a NAT/LB drops
# idle conns (surfaces as EOF on next use).
TESTKIT_SERVICE_REDIS_DIAL_TIMEOUT=5s
TESTKIT_SERVICE_REDIS_READ_TIMEOUT=3s
TESTKIT_SERVICE_REDIS_WRITE_TIMEOUT=3s
# Retries on transient failures (network resets, MOVED during failover).
# -1 = caller handles retry (e.g. non-idempotent writes).
TESTKIT_SERVICE_REDIS_MAX_RETRIES=3
TESTKIT_SERVICE_REDIS_MIN_RETRY_BACKOFF=8ms
TESTKIT_SERVICE_REDIS_MAX_RETRY_BACKOFF=512ms

# -----------------------------------------------------------------------------
# CORS — comma-separated allowed origins for the grpc-gateway HTTP surface.
# -----------------------------------------------------------------------------
TESTKIT_SERVICE_CORS_ALLOWED_ORIGINS=http://localhost:8080

# -----------------------------------------------------------------------------
# Third-party — the four downstream services. *_MODE: module = in-process
# (default; testkit embeds them sharing one PG/Redis pool); grpc = remote
# deployment. DB/Redis and gid/message adapters are injected via option, so the
# module-mode config payloads stay empty (see config.example.yaml).
# -----------------------------------------------------------------------------

# gid-service (snowflake ID generator; no DB)
TESTKIT_SERVICE_GID_MODE=module
# Only used when GID_MODE=grpc:
TESTKIT_SERVICE_GID_TARGET=
# module-mode snowflake config
TESTKIT_SERVICE_GID_MACHINE_ID=1
# snowflake epoch — DO NOT change after deployment
TESTKIT_SERVICE_GID_START_TIME=2026-01-01T00:00:00Z

# message-service
TESTKIT_SERVICE_MESSAGE_MODE=module
TESTKIT_SERVICE_MESSAGE_TARGET=
# Message app credentials (created on the message admin surface / DB)
TESTKIT_SERVICE_MESSAGE_APP_KEY=testkit
TESTKIT_SERVICE_MESSAGE_APP_SECRET=msg_dev_tk2026localdev
# P4: service label testkit injects into downstream message Send requests
# (NOT a user id). Override per ingress point if needed.
TESTKIT_SERVICE_MESSAGE_SENDER_ID=testkit-service

# message-service module-mode config (email/SMS provider credentials).
# reference-service (static reference data; no DB)
TESTKIT_SERVICE_REFERENCE_MODE=module
# Only used when REFERENCE_MODE=grpc:
TESTKIT_SERVICE_REFERENCE_TARGET=
# reference-service's OWN gRPC addr (module-mode config; unused but required non-empty):
REFERENCE_SERVICE_SERVER_GRPC_ADDR=":19094"

# DB/Redis and gid are injected; the vars below are message-service's OWN
# config, passed through verbatim. Module mode BOOTS with empty
# accounts/vendors, but SendEmail/SendSMS fail at runtime without them —
# fill per env. Defaults mirror message-service/.env.example.
TESTKIT_SERVICE_MESSAGE_IDEMPOTENCY_KEY_PREFIX=msg:idem
TESTKIT_SERVICE_MESSAGE_EMAIL_PERSISTENCE=true
TESTKIT_SERVICE_MESSAGE_EMAIL_IDEMPOTENCY_TTL=5m
TESTKIT_SERVICE_MESSAGE_EMAIL_PRIMARY_NAME=default
TESTKIT_SERVICE_MESSAGE_EMAIL_PRIMARY_VENDOR=aliyun
TESTKIT_SERVICE_MESSAGE_EMAIL_PRIMARY_HOST=smtp.example.com
TESTKIT_SERVICE_MESSAGE_EMAIL_PRIMARY_PORT=587
TESTKIT_SERVICE_MESSAGE_EMAIL_PRIMARY_USERNAME=replace-me
TESTKIT_SERVICE_MESSAGE_EMAIL_PRIMARY_PASSWORD=replace-me
TESTKIT_SERVICE_MESSAGE_EMAIL_PRIMARY_FROM=noreply@example.com
TESTKIT_SERVICE_MESSAGE_EMAIL_ATTACHMENT_FETCH_TIMEOUT=30s
TESTKIT_SERVICE_MESSAGE_EMAIL_ATTACHMENT_MAX_BYTES=10485760
TESTKIT_SERVICE_MESSAGE_EMAIL_ATTACHMENT_MAX_INLINE_BYTES=2097152
TESTKIT_SERVICE_MESSAGE_EMAIL_ATTACHMENT_MAX_TOTAL_INLINE_BYTES=5242880
TESTKIT_SERVICE_MESSAGE_SMS_DEFAULT_COUNTRY=CN
TESTKIT_SERVICE_MESSAGE_SMS_PERSISTENCE=true
TESTKIT_SERVICE_MESSAGE_SMS_IDEMPOTENCY_TTL=5m
TESTKIT_SERVICE_MESSAGE_SMS_ALIYUN_PRIMARY_NAME=default
TESTKIT_SERVICE_MESSAGE_SMS_ALIYUN_PRIMARY_ACCESS_KEY_ID=replace-me
TESTKIT_SERVICE_MESSAGE_SMS_ALIYUN_PRIMARY_ACCESS_KEY_SECRET=replace-me
TESTKIT_SERVICE_MESSAGE_SMS_ALIYUN_PRIMARY_SIGN_NAME=replace-me
TESTKIT_SERVICE_MESSAGE_SMS_ALIYUN_PRIMARY_REGION_ID=cn-hangzhou

# storage-service
TESTKIT_SERVICE_STORAGE_MODE=module
TESTKIT_SERVICE_STORAGE_TARGET=

# storage-service module-mode config (cloud provider/bucket credentials).
# DB/Redis and gid are injected; the vars below are storage-service's OWN
# config, passed through verbatim. upload_token_secret + default_bucket + at
# least one provider are storage-service Validate()-enforced — without them
# module mode boots but every storage RPC fails at runtime. Defaults mirror
# storage-service/.env.example.
TESTKIT_SERVICE_STORAGE_UPLOAD_TOKEN_SECRET=change-me-generate-a-random-secret
TESTKIT_SERVICE_STORAGE_DEFAULT_BUCKET=default
# Active Aliyun OSS provider scaffold — replace creds per env.
TESTKIT_SERVICE_STORAGE_PROVIDER_NAME=aliyun-primary
TESTKIT_SERVICE_STORAGE_PROVIDER_VENDOR=VENDOR_ALIYUN_OSS
TESTKIT_SERVICE_STORAGE_PROVIDER_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
TESTKIT_SERVICE_STORAGE_PROVIDER_REGION=cn-hangzhou
TESTKIT_SERVICE_STORAGE_PROVIDER_ACCESS_KEY=change-me
TESTKIT_SERVICE_STORAGE_PROVIDER_SECRET_KEY=change-me
# STS via GetSTSCredential (vendor-specific role_arn format); empty = unavailable.
# TESTKIT_SERVICE_STORAGE_PROVIDER_ROLE_ARN=
# Must include DEFAULT_BUCKET above (or add more buckets in config.yaml).
TESTKIT_SERVICE_STORAGE_PROVIDER_BUCKET_NAME=default
TESTKIT_SERVICE_STORAGE_PROVIDER_BUCKET_KEY_PREFIX=uploads/
TESTKIT_SERVICE_STORAGE_PROVIDER_BUCKET_ACL=private

# user-service
TESTKIT_SERVICE_USER_MODE=module
TESTKIT_SERVICE_USER_TARGET=

# user-service module-mode OAuth providers (user-service's OWN config, passed
# through verbatim). Empty client_id/app_id DISABLES that provider — user-service
# skips unconfigured providers, so testkit boots with OAuth off until you fill
# one in. redirect_url must EXACTLY match the provider-registered URL.
# session/rbac/captcha/rate_limit/cron mirror user-service's built-in defaults
# (the block ships wired-but-stock; override per env).
TESTKIT_SERVICE_USER_OAUTH_GITHUB_CLIENT_ID=
TESTKIT_SERVICE_USER_OAUTH_GITHUB_CLIENT_SECRET=
TESTKIT_SERVICE_USER_OAUTH_GITHUB_REDIRECT_URL=https://auth.corp.com/oauth/callback
TESTKIT_SERVICE_USER_OAUTH_GITHUB_ALLOWED_REDIRECT_URLS=https://app.corp.com/auth/done,https://admin.corp.com/auth/done
TESTKIT_SERVICE_USER_OAUTH_GOOGLE_CLIENT_ID=
TESTKIT_SERVICE_USER_OAUTH_GOOGLE_CLIENT_SECRET=
TESTKIT_SERVICE_USER_OAUTH_GOOGLE_REDIRECT_URL=https://auth.corp.com/oauth/callback
TESTKIT_SERVICE_USER_OAUTH_GOOGLE_ALLOWED_REDIRECT_URLS=https://app.corp.com/auth/done,https://admin.corp.com/auth/done
TESTKIT_SERVICE_USER_OAUTH_WECHAT_APP_ID=
TESTKIT_SERVICE_USER_OAUTH_WECHAT_APP_SECRET=
TESTKIT_SERVICE_USER_OAUTH_WECHAT_REDIRECT_URL=https://auth.corp.com/oauth/callback
TESTKIT_SERVICE_USER_OAUTH_WECHAT_ALLOWED_REDIRECT_URLS=https://app.corp.com/auth/done,https://admin.corp.com/auth/done
TESTKIT_SERVICE_USER_OAUTH_APPLE_CLIENT_ID=
TESTKIT_SERVICE_USER_OAUTH_APPLE_TEAM_ID=
TESTKIT_SERVICE_USER_OAUTH_APPLE_KEY_ID=
TESTKIT_SERVICE_USER_OAUTH_APPLE_PRIVATE_KEY=
TESTKIT_SERVICE_USER_OAUTH_APPLE_REDIRECT_URL=https://auth.corp.com/oauth/callback
TESTKIT_SERVICE_USER_OAUTH_APPLE_ALLOWED_REDIRECT_URLS=https://app.corp.com/auth/done,https://admin.corp.com/auth/done
TESTKIT_SERVICE_USER_OAUTH_APPLE_CLIENT_SECRET_TTL=30m

# session (Redis-backed sessions)
TESTKIT_SERVICE_USER_SESSION_TTL=168h
TESTKIT_SERVICE_USER_SESSION_MAX_SESSIONS=5
TESTKIT_SERVICE_USER_SESSION_KEY_PREFIX=user:session
TESTKIT_SERVICE_USER_SESSION_USER_SESSIONS_PREFIX=user:user_sessions
TESTKIT_SERVICE_USER_SESSION_CODE_TTL=5m
# rbac cache (TTLs + Redis key prefixes)
TESTKIT_SERVICE_USER_RBAC_USER_PERMS_TTL=10m
TESTKIT_SERVICE_USER_RBAC_USER_ROLES_TTL=10m
TESTKIT_SERVICE_USER_RBAC_ROLE_PERMS_TTL=30m
TESTKIT_SERVICE_USER_RBAC_GROUP_ROLES_TTL=30m
TESTKIT_SERVICE_USER_RBAC_GROUP_USER_PERMS_TTL=10m
TESTKIT_SERVICE_USER_RBAC_USER_PERMS_PREFIX=user:rbac:user_perms
TESTKIT_SERVICE_USER_RBAC_USER_ROLES_PREFIX=user:rbac:user_roles
TESTKIT_SERVICE_USER_RBAC_ROLE_PERMS_PREFIX=user:rbac:role_perms
TESTKIT_SERVICE_USER_RBAC_GROUP_ROLES_PREFIX=user:rbac:group_roles
TESTKIT_SERVICE_USER_RBAC_GROUP_USER_PERMS_PREFIX=user:rbac:group_user_perms
# captcha (verification codes). CAPTCHA_WINDOW is also the code TTL (shortest window).
TESTKIT_SERVICE_USER_CAPTCHA_PREFIX=captcha
TESTKIT_SERVICE_USER_CAPTCHA_MAX_ATTEMPTS=3
TESTKIT_SERVICE_USER_CAPTCHA_WINDOW=5m
TESTKIT_SERVICE_USER_CAPTCHA_MAX=5
# rate limiting (login attempts / send-code volume)
TESTKIT_SERVICE_USER_RATE_LIMIT_LOGIN_PREFIX=user:ratelimit:login
TESTKIT_SERVICE_USER_RATE_LIMIT_LOGIN_WINDOW=1m
TESTKIT_SERVICE_USER_RATE_LIMIT_LOGIN_MAX=5
TESTKIT_SERVICE_USER_RATE_LIMIT_CODE_PREFIX=user:ratelimit:code
TESTKIT_SERVICE_USER_RATE_LIMIT_CODE_WINDOW=1m
TESTKIT_SERVICE_USER_RATE_LIMIT_CODE_MAX=3
# cron scheduler
TESTKIT_SERVICE_USER_CRON_TIMEZONE=Asia/Shanghai

# -----------------------------------------------------------------------------
# Cron scheduler (jobs.Scheduler is wired but registers no jobs in P1).
# -----------------------------------------------------------------------------
TESTKIT_SERVICE_CRON_TIMEZONE=Asia/Shanghai

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
TESTKIT_SERVICE_LOG_LEVEL=info
TESTKIT_SERVICE_LOG_FORMAT=json
# Optional service-name prefix (e.g. testkit-service → [testkit-service]); empty = none.
TESTKIT_SERVICE_LOG_SERVICE=
# Optional file output with rotation (lumberjack). Empty path = stdout only.
TESTKIT_SERVICE_LOG_FILE_PATH=
TESTKIT_SERVICE_LOG_FILE_MAX_SIZE_MB=100
TESTKIT_SERVICE_LOG_FILE_MAX_BACKUPS=3
TESTKIT_SERVICE_LOG_FILE_MAX_AGE_DAYS=7
TESTKIT_SERVICE_LOG_FILE_COMPRESS=false

# --- license-service (module mode; see third_party.license in config.example.yaml) ---
TESTKIT_SERVICE_LICENSE_MODE=module
TESTKIT_SERVICE_LICENSE_TARGET=
TESTKIT_SERVICE_LICENSE_SIGNING_KEY_ID=k1
# 64-hex (32-byte) Ed25519 seed — generate with: openssl rand -hex 32
TESTKIT_SERVICE_LICENSE_SIGNING_SEED=
TESTKIT_SERVICE_LICENSE_SIGNING_SIGN_KEY_ID=

# --- telemetry-service (module mode) ---
TESTKIT_SERVICE_TELEMETRY_MODE=module
TESTKIT_SERVICE_TELEMETRY_TARGET=
TESTKIT_SERVICE_TELEMETRY_ADMIN_TOKEN=change-me

# storage-service app credentials (seeded by `storage-service migrate --seed-from-config`)
TESTKIT_SERVICE_STORAGE_APP_KEY=testkit
TESTKIT_SERVICE_STORAGE_APP_SECRET=change-me

# license-service app credentials (created on the license admin surface: 应用管理 → 新建)
TESTKIT_SERVICE_LICENSE_APP_KEY=testkit
TESTKIT_SERVICE_LICENSE_APP_SECRET=change-me

# telemetry-service app credentials (created on the telemetry admin surface: 应用管理 → 新建)
TESTKIT_SERVICE_TELEMETRY_APP_KEY=testkit
TESTKIT_SERVICE_TELEMETRY_APP_SECRET=change-me

# user-service tenant credentials (created on the user admin surface: 用户服务 → 应用管理)
TESTKIT_SERVICE_USER_APP_KEY=testkit
TESTKIT_SERVICE_USER_APP_SECRET=change-me
