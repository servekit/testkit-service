# Environment template. Copy to .env and edit:
#   cp .env.example .env
#
# These values are docker-compose oriented (hostnames are compose service
# names). config.example.yaml references every value via ${VAR}, expanded by
# configx at startup. The binary never reads this file directly — load it into
# the environment:
#   - local binary (make run): godotenv loads .env automatically
#   - docker compose: reads .env for ${VAR} interpolation
#
# For LOCAL binary runs, change docker hostnames to local addresses, e.g.:
#   TESTKIT_SERVICE_DATABASE_HOST: postgres -> localhost
#
# Never commit real production secrets — keep them in .env (gitignored), the CI
# secret store, or the deployment secret manager.

TESTKIT_SERVICE_SERVER_GRPC_ADDR=:9000
TESTKIT_SERVICE_SERVER_HTTP_ADDR=:8080

TESTKIT_SERVICE_REDIS_ADDR=redis:6379
TESTKIT_SERVICE_REDIS_USERNAME=
TESTKIT_SERVICE_REDIS_PASSWORD=
TESTKIT_SERVICE_REDIS_DB=0

TESTKIT_SERVICE_THIRD_PARTY_DEMO_MODE=module
TESTKIT_SERVICE_THIRD_PARTY_DEMO_TARGET=
TESTKIT_SERVICE_THIRD_PARTY_DEMO_CONFIG_PREFIX=[demo]
TESTKIT_SERVICE_THIRD_PARTY_DEMO_CONFIG_MAX_INPUT_LEN=1024

TESTKIT_SERVICE_CRON_TIMEZONE=Asia/Shanghai

TESTKIT_SERVICE_LOG_LEVEL=info
TESTKIT_SERVICE_LOG_FORMAT=json
